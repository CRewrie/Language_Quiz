{
  "id": "zh-b1-prepositions",
  "category": "Mandarin B1",
  "language": "zh",
  "title": "Prepositions: 对, 给, 为, 往 / 向, 关于, 通过, 直到",
  "description": "Towards / about someone (对), for / to (给, 为), direction (往, 向), about (关于), through (通过), and 'not until' (直到…才).",
  "level": "B1",
  "points": [
    {
      "id": "dui",
      "title": "对 + person / thing",
      "summary": "对 (duì) = towards, to: 对我很好 (good to me), 对…感兴趣 (interested in).",
      "body": "- 他**对**我很好.\n- 我**对**中国历史很感兴趣.",
      "examples": [
        [
          "{我|wǒ}{对|duì}{中国|Zhōngguó}{历史|lìshǐ}{很|hěn}{感兴趣|gǎn xìngqù}。",
          "I'm very interested in Chinese history."
        ]
      ]
    },
    {
      "id": "gei",
      "title": "给 + person + verb",
      "summary": "给 (gěi) + person + verb = do something for / to someone: 给你打电话, 给妈妈写信.",
      "body": "- 我**给**你打电话.\n- 我**给**妈妈写了一封信.",
      "examples": [
        [
          "{我|wǒ}{给|gěi}{妈妈|māma}{写|xiě}{了|le}{一|yì}{封|fēng}{信|xìn}。",
          "I wrote a letter to my mum."
        ]
      ]
    },
    {
      "id": "wei",
      "title": "为 + person: for (the sake of)",
      "summary": "为 (wèi) + person = for someone's sake / benefit. 为…高兴 = happy for.",
      "body": "- 我真**为**你高兴!",
      "examples": [
        [
          "{我|wǒ}{真|zhēn}{为|wèi}{你|nǐ}{高兴|gāoxìng}！",
          "I'm really happy for you!"
        ]
      ]
    },
    {
      "id": "wangxiang",
      "title": "往 / 向: towards",
      "summary": "往 (wǎng) + direction + verb: 往前走. 向 (xiàng) also takes people: 向他学习 (learn from him).",
      "body": "- 一直**往**前走.\n- 我们应该**向**他学习.",
      "examples": [
        [
          "{一直|yìzhí}{往|wǎng}{前|qián}{走|zǒu}。",
          "Go straight ahead."
        ]
      ]
    },
    {
      "id": "guanyu",
      "title": "关于: about, concerning",
      "summary": "关于 (guānyú) + topic = about …, before a noun (关于…的书) or at the start of a sentence.",
      "body": "- 一本**关于**中国历史的书.",
      "examples": [
        [
          "{这|zhè}{是|shì}{一|yì}{本|běn}{关于|guānyú}{中国|Zhōngguó}{历史|lìshǐ}{的|de}{书|shū}。",
          "This is a book about Chinese history."
        ]
      ]
    },
    {
      "id": "tongguo",
      "title": "通过: through, by means of",
      "summary": "通过 (tōngguò) + person / method = via, through.",
      "body": "- 我是**通过**朋友认识她的.",
      "examples": [
        [
          "{我|wǒ}{是|shì}{通过|tōngguò}{朋友|péngyou}{认识|rènshi}{她|tā}{的|de}。",
          "I met her through a friend."
        ]
      ]
    },
    {
      "id": "zhidao",
      "title": "直到 … 才: not until",
      "summary": "直到 (zhídào) + time / event，(subject) + 才 + verb = it took until … for ….",
      "body": "- **直到**昨天，我**才**知道这件事.",
      "examples": [
        [
          "{直到|zhídào}{昨天|zuótiān}，{我|wǒ}{才|cái}{知道|zhīdào}{这|zhè}{件|jiàn}{事|shì}。",
          "I didn't find out about it until yesterday."
        ]
      ]
    }
  ],
