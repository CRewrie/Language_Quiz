  "points": [
    {
      "id": "liang",
      "title": "二 vs 两",
      "summary": "二 (èr) is for counting, digits and ordinals (十二, 第二). 两 (liǎng) is 'two of something' before a measure word, and 2 o'clock.",
      "body": "- **两**个人, **两**本书, **两**点.\n- 十**二**, **二**月, 第**二**, 二十**二**个.\n- 俩 (liǎ) already contains 个: 我们俩.",
      "examples": [
        [
          "{我|wǒ}{有|yǒu}{两|liǎng}{个|ge}{妹妹|mèimei}。",
          "I have two younger sisters."
        ]
      ]
    },
    {
      "id": "ge",
      "title": "Number + 个 + noun",
      "summary": "Chinese needs a measure word between number and noun. 个 (ge) is the general one.",
      "body": "- 三**个**学生, 一**个**苹果.\n- ~~三学生~~ ✗",
      "examples": [
        [
          "{我们|wǒmen}{班|bān}{有|yǒu}{二十|èrshí}{个|ge}{学生|xuésheng}。",
          "There are twenty students in our class."
        ]
      ]
    },
    {
      "id": "sui",
      "title": "Age: number + 岁",
      "summary": "Age = number + 岁 (suì), usually without 是 and never with 有.",
      "body": "- 我妹妹八**岁** (My sister is eight).\n- ~~他有二十岁~~ ✗",
      "examples": [
        [
          "{我|wǒ}{妹妹|mèimei}{今年|jīnnián}{八|bā}{岁|suì}。",
          "My little sister is eight this year."
        ]
      ]
    },
    {
      "id": "time",
      "title": "Times and dates: 点, 星期, 年月日",
      "summary": "Clock: number + 点 (+ 半 / 分). Weekday: 星期 + 1–6, 星期天. Dates go from big to small: 年 → 月 → 日/号.",
      "body": "- 两**点半** (2:30), 七**点** (7:00).\n- **星期三** (Wednesday).\n- 2024**年**5**月**15**日**.",
      "examples": [
