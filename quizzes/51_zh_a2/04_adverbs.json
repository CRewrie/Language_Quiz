{
  "id": "zh-a2-adverbs",
  "category": "Mandarin A2",
  "language": "zh",
  "title": "Small Adverbs: 就, 还, 只, 总是, 别, 一边…一边, 又…又",
  "description": "Early/right away (就), also/OK-ish (还), only (只), always (总是), don't/stop (别…了), doing two things at once and 'both … and'.",
  "level": "A2",
  "points": [
    {
      "id": "jiu",
      "title": "就: (as early as) / right away",
      "summary": "就 (jiù) + verb: earlier/sooner than expected, or 'right away'. Often with 了.",
      "body": "- 他六点**就**起床了 (He got up as early as six).\n- 我马上**就**来.",
      "examples": [
        [
          "{我|wǒ}{马上|mǎshàng}{就|jiù}{来|lái}。",
          "I'll be right there."
        ]
      ]
    },
    {
      "id": "hai",
      "title": "还: also; (it's) OK",
      "summary": "还 + verb = in addition (还买了…). 还 + adj = reasonably, OK-ish: 还可以, 还不错.",
      "body": "- 我买了苹果，**还**买了香蕉.\n- 这个电影**还**可以 (It's OK).",
      "examples": [
        [
          "{这个|zhège}{电影|diànyǐng}{还|hái}{可以|kěyǐ}。",
          "This film is OK."
        ]
      ]
    },
    {
      "id": "zhi",
      "title": "只 + verb: only",
      "summary": "只 (zhǐ) goes **before the verb**, even when 'only' refers to the object.",
      "body": "- 我**只**会说一点儿中文.\n- 我**只**有一百块钱.",
      "examples": [
        [
          "{我|wǒ}{只|zhǐ}{有|yǒu}{一百|yìbǎi}{块|kuài}{钱|qián}。",
          "I only have 100 yuan."
        ]
      ]
    },
    {
      "id": "zongshi",
      "title": "总是 + verb: always",
      "summary": "总是 (zǒngshì) = always, every time (habit, often annoying).",
      "body": "- 他**总是**迟到.",
      "examples": [
        [
          "{他|tā}{总是|zǒngshì}{迟到|chídào}。",
          "He's always late."
        ]
      ]
    },
    {
      "id": "bie",
      "title": "别 + verb (+ 了): don't / stop",
      "summary": "别 (bié) + verb = don't. 别 + verb + 了 = stop doing it (it's happening now).",
      "body": "- **别**担心.\n- **别**说话**了**! (Stop talking!)",
      "examples": [
        [
          "{别|bié}{说话|shuōhuà}{了|le}！",
          "Stop talking!"
        ]
      ]
    },
    {
      "id": "yibian",
      "title": "一边 A 一边 B: doing A while B",
      "summary": "一边 + verb 1，一边 + verb 2 = doing both at the same time.",
      "body": "- 他**一边**吃饭，**一边**看电视.",
      "examples": [
        [
          "{我们|wǒmen}{一边|yìbiān}{走|zǒu}{一边|yìbiān}{聊天|liáotiān}。",
          "We chatted as we walked."
        ]
      ]
    },
    {
      "id": "youyou",
      "title": "又 A 又 B: both A and B",
      "summary": "又 + adj/verb，又 + adj/verb = both … and … (same direction: both good or both bad).",
      "body": "- 这个苹果**又**大**又**甜.",
      "examples": [
        [
          "{他|tā}{又|yòu}{高|gāo}{又|yòu}{帅|shuài}。",
          "He's both tall and handsome."
        ]
      ]
    }
  ],
